meta {
  name: REGISTER
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/mobileapps/register
  body: multipartForm
  auth: none
}

headers {
  Accept: application/json
}

body:multipart-form {
  name: Angga Angga
  email: angga.amgga@upi.edu
  password: 12345
  password_confirmation: 12345
  role_name: farmer
}

settings {
  encodeUrl: true
}

docs {
  # **POST REGISTER USER**

  | Key | Value |
  | --- | --- |
  | name | nama user |
  | email | email user |
  | password | password |
  | password_confirmation | konfirmasi password |
  | role_name | `farmer` atau `consumer` |
}
