meta {
  name: LIST ARTICLE HOME ALL CATEGORY
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/public/posts_home
  body: none
  auth: none
}

settings {
  encodeUrl: true
}

docs {
  # **GET POSTS HOME (top 6, all categories)**

  Menampilkan 6 post terbaru lintas kategori untuk halaman home.

  Setiap item include `metadata` (JSON object, since 2026-05-27 — extras per-kategori, nullable) di samping `source_url`/`embed_provider`/`embed` yang sudah ada untuk post sosial.
}
