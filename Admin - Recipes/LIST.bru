meta {
  name: LIST
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/recipes
  body: none
  auth: inherit
}

params:query {
  page: 1
  q: ~
  type: ~
}

headers {
  Accept: application/json
}

docs {
  Paginated list of recipes for the admin panel.

  **Query params:**
  - `page` (int, default 1)
  - `q` (string, optional) — search across title
  - `type` (string, optional) — `food` or `drink`
}

example {
  name: List: Success

  request: {
    url: {{baseUrl}}/admin/recipes?page=1
    method: GET
    mode: none
    headers: {
      Accept: application/json
      Authorization: Bearer {{token}}
    }
  }

  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "List Recipes",
          "data": {
            "current_page": 1,
            "per_page": 15,
            "total": 152,
            "last_page": 11,
            "data": [
              {
                "id": 1,
                "slug": "gado-gado-sayur",
                "title": "Gado-Gado Sayur",
                "type": "food",
                "image_url": "https://webapi.myindah-app.com/storage/recipes/gado-gado.jpg",
                "kcal": 320,
                "durasi_menit": 35,
                "porsi": 4,
                "difficulty": "Mudah",
                "kategori": "Berbasis sayur",
                "tags": ["sayur", "tahu/tempe", "bumbu kacang"]
              }
            ]
          }
        }
      '''
    }
  }
}

example {
  name: List: Forbidden (non-admin)

  request: {
    url: {{baseUrl}}/admin/recipes
    method: GET
    mode: none
    headers: {
      Accept: application/json
      Authorization: Bearer {{token}}
    }
  }

  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "User does not have the right permissions."
        }
      '''
    }
  }
}
