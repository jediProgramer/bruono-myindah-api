meta {
  name: UPDATE
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/mobileapps/users/{{userId}}
  body: multipartForm
  auth: inherit
}

headers {
  Accept: application/json
}

body:multipart-form {
  name: Erlangga
  email: erlangga@upi.edu
  role_name: consumer
  _method: PATCH
}

vars:pre-request {
  userId: 1
}

settings {
  encodeUrl: true
}

docs {
  # **UPDATE USER**

  POST with `_method=PATCH` (multipart hack for file upload).

  | Key | Type | Value |
  | --- | --- | --- |
  | name | text | nama user |
  | email | text | email |
  | password | text | opsional; sertakan `password_confirmation` jika diisi |
  | role_name | text | `farmer` atau `consumer` |
  | image | file | foto profil (opsional) |
  | _method | text | PATCH |
}
