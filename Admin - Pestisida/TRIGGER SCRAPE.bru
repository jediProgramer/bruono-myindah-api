meta {
  name: TRIGGER SCRAPE
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/pestisida/scrape
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

docs {
  Forces an out-of-schedule run of the pestisida.id scraper. Useful when the weekly cron (Monday 03:30 Asia/Jakarta) failed and ops needs to rerun.

  Dispatched to the queue worker; takes ~3–5 minutes to complete. Throttled to one run every 30 minutes.
}

example {
  name: Trigger: Success

  request: {
    url: {{baseUrl}}/admin/pestisida/scrape
    method: POST
    mode: none
    headers: {
      Accept: application/json
      Authorization: Bearer {{token}}
    }
  }

  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }

    status: {
      code: 202
      text: Accepted
    }

    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Scrape job dispatched",
          "data": {
            "job_id": "9f1c8a7b-3e2d-4f5a-9b8c-2d1e3f4a5b6c"
          }
        }
      '''
    }
  }
}

example {
  name: Trigger: Throttled

  request: {
    url: {{baseUrl}}/admin/pestisida/scrape
    method: POST
    mode: none
    headers: {
      Accept: application/json
      Authorization: Bearer {{token}}
    }
  }

  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }

    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "A scrape job was dispatched in the last 30 minutes. Wait before triggering again."
        }
      '''
    }
  }
}
