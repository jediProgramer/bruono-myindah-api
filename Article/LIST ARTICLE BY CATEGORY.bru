meta {
  name: LIST ARTICLE BY CATEGORY
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/public/posts/category/6?page=1
  body: none
  auth: none
}

params:query {
  page: 1
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

docs {
  Paginated list of posts in a single category. Use this when the user taps a category link in the public site / mobile app.

  **URL params:**
  - `{category_id}` — numeric id (see `/public/category_list` for the full list).

  **Known categories on prod (id → name):**
  - `1` Tips
  - `2` Iklim
  - `3` Resep
  - `4` Social Media
  - `6` Tanaman          — 23 Tanaman Pangan + Hortikultura entries (each with real Wikipedia photo + metadata)
  - `7` Hama & Penyakit  — 25 entries (14 hama + 11 penyakit), each with real Wikipedia photo + metadata

  **`metadata` field (since 2026-05-27):**
  Optional JSON object for category-specific structured extras. Null on most posts.

  **For Tanaman (category_id=6):**
  ```
  {
    "nama_latin": "Capsicum frutescens",
    "kategori_tanaman": "sayuran",         // pangan | sayuran | buah | herba | palawija
    "musim_tanam": "sepanjang_tahun",      // hujan | kemarau | sepanjang_tahun
    "hari_panen_min": 75,
    "hari_panen_max": 90,
    "tingkat_kesulitan": "sedang",         // mudah | sedang | sulit
    "kebutuhan_sinar": "penuh",            // penuh | sebagian | teduh
    "kondisi_tumbuh": { "ph_min": 5.5, "ph_max": 6.8, "suhu_min": 18, "suhu_max": 30, "mdpl_min": 0, "mdpl_max": 1000 },
    "hama_umum": ["thrips", "kutu daun"],
    "catatan_panen": "Mulai berbuah 3-4 tahun setelah tanam"  // optional, for slow fruit trees
  }
  ```

  **For Hama & Penyakit (category_id=7):**
  ```
  {
    "nama_latin": "Pyricularia oryzae",
    "tipe": "penyakit",                    // hama | penyakit  (drives Hama/Penyakit sub-tab filter)
    "kategori_organisme": "jamur",         // serangga | tungau | tikus | siput | nematoda | jamur | virus | bakteri
    "tingkat_keparahan": "berat",          // ringan | sedang | berat
    "tanaman_inang": ["Padi"],             // host crop display names (match Tanaman titles when possible)
    "gejala": "Bercak belah ketupat …",    // symptoms (Indonesian)
    "pengendalian": "Varietas tahan; fungisida sistemik (trisiklazol) saat awal gejala."
  }
  ```

  Other categories may use their own keys (e.g. Resep can carry nutrition; Tips can stay null). Mobile reads `post.metadata.xxx` directly — array cast applied server-side.
}

example {
  name: Tanaman — first page

  request: {
    url: {{baseUrl}}/public/posts/category/6?page=1
    method: GET
    mode: none
    headers: {
      Accept: application/json
    }
  }

  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "List Data Posts",
          "data": {
            "current_page": 1,
            "per_page": 10,
            "total": 23,
            "last_page": 3,
            "data": [
              {
                "id": 29,
                "title": "Nanas",
                "slug": "nanas",
                "image": "https://webapi.myindah-app.com/storage/posts/nanas.jpg",
                "content": "Tanaman buah tropis. Sentra: Subang, Lampung, Kediri.",
                "category_id": 6,
                "user_id": 1,
                "source_url": null,
                "embed_provider": null,
                "metadata": null,
                "embed": null,
                "user": { "id": 1, "name": "Administrator" },
                "category": { "id": 6, "name": "Tanaman" },
                "created_at": "2026-05-26T13:53:02.000000Z",
                "updated_at": "2026-05-26T13:53:04.000000Z"
              },
              {
                "id": 14,
                "title": "Cabai Rawit",
                "slug": "cabai-rawit",
                "image": "https://webapi.myindah-app.com/storage/posts/cabai-rawit.jpg",
                "content": "Sayuran rempah dengan permintaan tinggi sepanjang tahun.",
                "category_id": 6,
                "metadata": {
                  "nama_latin": "Capsicum frutescens",
                  "kategori_tanaman": "sayuran",
                  "musim_tanam": "sepanjang_tahun",
                  "hari_panen_min": 75,
                  "hari_panen_max": 90,
                  "tingkat_kesulitan": "sedang",
                  "kebutuhan_sinar": "penuh",
                  "kondisi_tumbuh": { "ph_min": 5.5, "ph_max": 6.8, "suhu_min": 18, "suhu_max": 30 },
                  "hama_umum": ["thrips", "kutu daun"]
                },
                "category": { "id": 6, "name": "Tanaman" }
              }
            ]
          }
        }
      '''
    }
  }
}

