              { "merek_id": 98, "merek_pestisida": "AGAFENA 230 EC", "komoditas_list": ["Cabai"], "jenis_sasaran_list": ["hama trips"], "sasaran_count": 1 },
              { "merek_id": 12, "merek_pestisida": "AMISTAR 250 SC",  "komoditas_list": ["Padi", "Cabai"], "jenis_sasaran_list": ["antraknosa"], "sasaran_count": 2 }
            ]
          }
