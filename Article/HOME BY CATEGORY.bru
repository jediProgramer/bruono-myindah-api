meta {
  name: HOME BY CATEGORY
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/public/home_by_category
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  Public endpoint used by the homepage. Returns every category that has at least one post, with the latest **5 posts** attached to each (sorted by `id` asc). Posts inside a section include the same fields as any other public post — including the synthesized `embed` object when `embed_provider` is set, and the new `metadata` JSON object (since 2026-05-27).

  Use this to render the homepage as a sectioned feed (one section per category).

  **Per-section `source` (sejak 2026-06-07):** each section in `data[]` includes its own `source = {name, url}` when known (resep → "Kurasi BRIN"; tanaman → "Satu Data Pertanian"; hama-penyakit → "Wikipedia Commons"). `null` otherwise. Render under the section header.
}

example {
  name: Home by category — typical response

  request: {
    url: {{baseUrl}}/public/home_by_category
    method: GET
    mode: none
    headers: {
      Accept: application/json
    }
  }

  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Home grouped by category",
          "data": [
