meta {
  name: META
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/mobileapps/harga-pangan/meta
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  Returns the filter dropdown options that Flutter renders on the screen (komoditas list, provinsi list, jenis pasar list). Cached server-side, refreshed weekly.
}

example {
  name: Meta: Success

  request: {
    url: {{baseUrl}}/mobileapps/harga-pangan/meta
    method: GET
    mode: none
    headers: {
      Accept: application/json
    }
  }

  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Filter options",
          "data": {
            "komoditas": [
              { "slug": "beras",         "label": "Beras" },
              { "slug": "daging-ayam",   "label": "Daging Ayam" },
              { "slug": "daging-sapi",   "label": "Daging Sapi" },
              { "slug": "telur-ayam",    "label": "Telur Ayam" },
              { "slug": "bawang-merah",  "label": "Bawang Merah" },
              { "slug": "bawang-putih",  "label": "Bawang Putih" },
              { "slug": "cabai-merah",   "label": "Cabai Merah" },
              { "slug": "cabai-rawit",   "label": "Cabai Rawit" },
              { "slug": "minyak-goreng", "label": "Minyak Goreng" },
              { "slug": "gula-pasir",    "label": "Gula Pasir" }
            ],
            "provinsi": [
              { "slug": "dki-jakarta",   "label": "DKI Jakarta" },
              { "slug": "jawa-barat",    "label": "Jawa Barat" },
              { "slug": "di-yogyakarta", "label": "DI Yogyakarta" },
              { "slug": "jawa-timur",    "label": "Jawa Timur" }
            ],
            "jenis_pasar": [
              { "slug": "tradisional",    "label": "Pasar Tradisional" },
              { "slug": "modern",         "label": "Pasar Modern" },
              { "slug": "pedagang-besar", "label": "Pedagang Besar" },
              { "slug": "produsen",       "label": "Produsen" }
            ],
            "last_updated": "2026-05-21T07:00:00+07:00"
          }
        }
      '''
    }
  }
}

example {
  name: Meta: Unauthenticated

  request: {
    url: {{baseUrl}}/mobileapps/harga-pangan/meta
    method: GET
    mode: none
    headers: {
      Accept: application/json
    }
  }

  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "message": "Unauthenticated."
        }
      '''
    }
  }
}
