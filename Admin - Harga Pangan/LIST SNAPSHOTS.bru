meta {
  name: LIST SNAPSHOTS
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/harga-pangan/snapshots
  body: none
  auth: inherit
}

params:query {
  date: ~
  page: 1
}

headers {
  Accept: application/json
}

docs {
  Audit endpoint. Read-only paginated listing of `harga_pangan_snapshots` rows. Filter by `date=YYYY-MM-DD` to inspect a specific scrape day.

  **Query params:**
  - `date` (date YYYY-MM-DD, optional)
  - `page` (int, default 1)
}

example {
  name: List Snapshots: Today

  request: {
    url: {{baseUrl}}/admin/harga-pangan/snapshots?date=2026-05-21
    method: GET
    mode: none
    headers: {
      Accept: application/json
      Authorization: Bearer {{token}}
    }
  }

  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Snapshots",
          "data": {
            "current_page": 1,
            "per_page": 50,
            "total": 160,
            "last_page": 4,
            "data": [
              {
                "id": 1,
                "tanggal": "2026-05-21",
                "komoditas": "Beras",
                "komoditas_slug": "beras",
                "provinsi": "DKI Jakarta",
                "provinsi_slug": "dki-jakarta",
                "jenis_pasar": "Pasar Tradisional",
                "jenis_pasar_slug": "tradisional",
                "harga": 16900,
                "diff_rp": 100,
                "diff_pct": 0.6,
                "fetched_at": "2026-05-21T07:01:32+07:00"
              }
            ]
          }
        }
      '''
    }
  }
}

example {
  name: List Snapshots: Empty (no scrape that day)

  request: {
    url: {{baseUrl}}/admin/harga-pangan/snapshots?date=2026-05-17
    method: GET
    mode: none
    headers: {
      Accept: application/json
      Authorization: Bearer {{token}}
    }
  }

  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Snapshots",
          "data": {
            "current_page": 1,
            "per_page": 50,
            "total": 0,
            "last_page": 1,
            "data": []
          }
        }
      '''
    }
  }
}
