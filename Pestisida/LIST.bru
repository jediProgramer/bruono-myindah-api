meta {
  name: LIST
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/mobileapps/pestisida?per_page=20&page=1
  body: none
  auth: none
}

params:query {
  per_page: 20
  page: 1
  q: ~
  komoditas: ~
  jenis_sasaran: ~
}

headers {
  Accept: application/json
}

docs {
  Public paginated list of pesticide brands. One row per merek (not per sasaran) — each card carries a 1-line summary plus arrays of `komoditas_list` and `jenis_sasaran_list` so Flutter can render the brand card without a second call.

  **Query params:**
  - `per_page` (int, default 20, max 50)
  - `page` (int, default 1)
  - `q` (string, max 80) — matches merek, bahan aktif, or no. pendaftaran
  - `komoditas` (string, max 120) — substring match
  - `jenis_sasaran` (string, max 120) — substring match
}

example {
  name: List: First page

  request: {
    url: {{baseUrl}}/mobileapps/pestisida?per_page=20&page=1
    method: GET
    mode: none
    headers: {
      Accept: application/json
    }
  }

  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "List pestisida",
          "data": {
            "snapshot_date": "2026-05-26",
            "current_page": 1,
            "last_page": 300,
            "per_page": 20,
            "total": 5991,
            "data": [
              {
                "merek_id": 98,
                "merek_pestisida": "AGAFENA 230 EC",
                "bahan_aktif": "abamektin (abamectin): 30 g/l klorfenapir (chlorfenapyr): 200 g/l",
                "jenis_pestisida": "Insektisida racun kontak dan lambung berbentuk pekatan yang dapat diemulsikan",
                "pemegang_pendaftaran": "PT Agro Guna Makmur",
                "nomor_pendaftaran": "RI. 01010120155286",
                "tanggal_akhir_izin": "20 Januari 2031",
                "komoditas_list": ["Cabai"],
                "jenis_sasaran_list": ["hama trips"],
                "sasaran_count": 1
              }
            ]
          }
        }
      '''
    }
  }
}

example {
  name: List: Search by komoditas

  request: {
    url: {{baseUrl}}/mobileapps/pestisida?komoditas=cabai&per_page=10
    method: GET
    mode: none
    headers: {
      Accept: application/json
    }
  }

  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "List pestisida",
          "data": {
            "snapshot_date": "2026-05-26",
            "current_page": 1,
            "last_page": 12,
            "per_page": 10,
            "total": 117,
            "data": []
          }
        }
      '''
    }
  }
}
